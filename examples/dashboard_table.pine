//@version=6
indicator("Trend Dashboard", overlay=true)

rsiLen = input.int(14, "RSI length")
r = ta.rsi(close, rsiLen)
e9 = ta.ema(close, 9)
e21 = ta.ema(close, 21)
atr = ta.atr(14)

var t = table.new(position.top_right, 2, 6, bgcolor=color.new(#131722, 10), frame_color=color.new(color.gray, 40), frame_width=1, border_color=color.new(color.gray, 75), border_width=1)
var note = table.new(position.bottom_left, 1, 1)

if barstate.islast
    table.cell(t, 0, 0, "Trend Dashboard", text_color=color.white, bgcolor=color.new(color.purple, 40), text_size=size.normal)
    table.merge_cells(t, 0, 0, 1, 0)
    table.cell(t, 0, 1, "RSI", text_color=color.silver, text_halign=text.align_left)
    table.cell(t, 1, 1, str.tostring(r, "#.0"), text_color=r > 50 ? color.lime : color.red, text_size=size.large)
    table.cell(t, 0, 2, "EMA 9 / 21", text_color=color.silver, text_halign=text.align_left)
    table.cell(t, 1, 2, e9 > e21 ? "Bullish" : "Bearish", text_color=color.white, bgcolor=e9 > e21 ? color.new(color.green, 30) : color.new(color.red, 30))
    table.cell(t, 0, 3, "ATR", text_color=color.silver, text_halign=text.align_left)
    table.cell(t, 1, 3, str.tostring(atr, "#.00"), text_color=color.white, tooltip="Average True Range (14)")
    table.cell(t, 0, 4, "Close", text_color=color.silver, text_halign=text.align_left)
    table.cell(t, 1, 4, str.tostring(close, "#.00"), text_color=color.white, text_font_family=font.family_monospace)
    table.cell(t, 0, 5, "Updated live", text_color=color.gray, text_size=size.tiny)
    table.merge_cells(t, 0, 5, 1, 5)
    table.cell(note, 0, 0, "Bottom-left table", text_color=color.white, bgcolor=color.new(color.blue, 30))
