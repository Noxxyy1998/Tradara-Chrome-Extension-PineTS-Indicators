{
  "manifest_version": 3,
  "name": "PineTS Overlay for Tradara",
  "version": "0.6.0",
  "description": "Run Pine Script indicators and strategies (via PineTS) as an overlay on the Tradara Terminal chart.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "tts", "notifications"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "PineTS Overlay",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "options_page": "manager.html",
  "content_scripts": [
    {
      "matches": ["https://terminal.tradara.com/*"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://terminal.tradara.com/*"],
      "js": ["store.js", "settings-ui.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "sandbox": { "pages": ["sandbox.html"] },
  "web_accessible_resources": [
    { "resources": ["sandbox.html", "sandbox.js", "vendor/pinets.min.browser.js"], "matches": ["https://terminal.tradara.com/*"] }
  ]
}
